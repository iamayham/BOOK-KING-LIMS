# ─── Mail (Brevo only) ──────────────────────────────────────────────────────
MAIL_DRIVER=brevo

# Verified sender must match what you configured in your Brevo account.
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME="Book King"

# Brevo: transactional API (HTTPS :443) — prefer on Railway; SMTP :587 is often blocked
# Use the key from Brevo → SMTP & API → API keys (or the same xkeysib-* key you use for SMTP).
BREVO_API_KEY=

# SMTP relay (fallback / local dev)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ─── Feature Toggles ────────────────────────────────────────────────────────
# Set to 1/true to disable all /admin/* routes and run in user-only mode.
USER_ONLY_MODE=0
