# ─── Mail (Brevo only) ──────────────────────────────────────────────────────
MAIL_DRIVER=brevo

# Verified sender must match what you configured in your Brevo account.
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME="Book King"

# Brevo: transactional REST API over HTTPS (:443). Create a dedicated key:
# Dashboard → SMTP & API → API keys → generate (name it "OTP") — use that value here.
# The SMTP relay password alone may NOT work as api-key if it is SMTP-only creds.
BREVO_API_KEY=

# SMTP relay (fallback / local dev)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ─── Feature Toggles ────────────────────────────────────────────────────────
# Set to 1/true to disable all /admin/* routes and run in user-only mode.
USER_ONLY_MODE=0
