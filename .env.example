# ─── Mail ────────────────────────────────────────────────────────────────────
# Use either Brevo SMTP or Resend HTTP (not both unless you force MAIL_DRIVER).
#
# MAIL_DRIVER=brevo   | resend | (empty = auto: Brevo if BREVO_SMTP_* set, else Resend)
MAIL_DRIVER=

# Verified sender must match what you configured in your Brevo account.
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME="Book King"

# Brevo: SMTP relay (smtp-relay.brevo.com) — login & key from dashboard
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Resend API (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Book King
